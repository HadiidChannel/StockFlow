# StockFlow Environment Blueprint (Sanitized Template)

# Database Configuration (MySQL 8.4 LTS)
DB_ROOT_PASSWORD=your_mysql_root_password_change_in_production_32chars
DB_USER=stockflow_user
DB_PASSWORD=your_mysql_app_password_change_in_production_32chars
DATABASE_URL="mysql://stockflow_user:your_mysql_app_password_change_in_production_32chars@localhost:3306/stockflow_db"

# Backend Configuration
PORT=4000
# For development use http://localhost:3000. In production, HTTPS domain is required (e.g., https://app.stockflow.com)
FRONTEND_URL="https://app.stockflow.com"
COOKIE_DOMAIN=""
COOKIE_SECURE="true"
COOKIE_SAME_SITE="lax"
SESSION_SECRET="your_32_character_random_session_secret_change_me"
CSRF_SECRET="your_32_character_random_csrf_secret_change_me"
LOG_LEVEL="info"

# Initial Bootstrap (Optional for one-time initialization via bootstrap service)
INITIAL_ORG_NAME="PT StockFlow Logistik Nusantara"
INITIAL_ADMIN_NAME="System Administrator"
INITIAL_ADMIN_EMAIL="admin@stockflow.com"
INITIAL_ADMIN_PASSWORD="your_secure_admin_password_min_12_chars"
# INITIAL_ADMIN_PASSWORD_FILE="/run/secrets/admin_password"

# Frontend Configuration
# In production, leave NEXT_PUBLIC_API_URL empty so browser uses same-origin relative path /api/v1
NEXT_PUBLIC_API_URL=""
INTERNAL_BACKEND_URL="http://backend:4000"
