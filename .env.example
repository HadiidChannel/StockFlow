# Database Configuration
DB_ROOT_PASSWORD=your_strong_root_password_here
DB_USER=stockflow_user
DB_PASSWORD=your_strong_password_here
DATABASE_URL="mysql://stockflow_user:your_strong_password_here@localhost:3306/stockflow_db"

# Server Configuration
PORT=4000
NODE_ENV=production
APP_DEPLOYMENT_MODE=local
FRONTEND_URL="http://localhost:3000"
COOKIE_DOMAIN=""
COOKIE_SECURE="false"
COOKIE_SAME_SITE="lax"
SESSION_SECRET="your_high_entropy_session_secret_min_32_characters_here"
CSRF_SECRET="your_high_entropy_csrf_secret_min_32_characters_here"
LOG_LEVEL="info"

# Frontend Ingress & Reverse Proxy
NEXT_PUBLIC_API_URL="/api/v1"
