# StockFlow Backend Environment Blueprint (Sanitized Template)
NODE_ENV=production
PORT=4000
DATABASE_URL="mysql://stockflow_user:your_mysql_password_min_32_chars@db:3306/stockflow_db"
FRONTEND_URL="https://app.stockflow.com"
COOKIE_DOMAIN=""
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
SESSION_SECRET="your_32_character_random_session_secret_change_me"
CSRF_SECRET="your_32_character_random_csrf_secret_change_me"
LOG_LEVEL=info

# Initial Administrator Bootstrap (One-Time Execution via Dedicated Service)
INITIAL_ORG_NAME="PT StockFlow Logistik Nusantara"
INITIAL_ADMIN_NAME="System Administrator"
INITIAL_ADMIN_EMAIL="admin@stockflow.com"
INITIAL_ADMIN_PASSWORD="your_secure_admin_password_min_12_chars"
# INITIAL_ADMIN_PASSWORD_FILE="/run/secrets/admin_password"
