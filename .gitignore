# Root .gitignore

# Dependencies & Build Artifacts
node_modules/
.next/
dist/
build/
out/
.cache/
.turbo/
*.tsbuildinfo

# Logs & Coverage
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
coverage/

# OS & Editor Files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# Database Local Files
.prisma/
prisma/*.db
prisma/*.db-journal

# Test Artifacts
test-results/
playwright-report/
results.json

# Credentials, Secrets & Private Keys
.env
.env.*
!.env.example
!backend/.env.example
!frontend/.env.example
.secrets/
*.secret
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*credentials*.json
*service-account*.json

# Release Archives, Audit & Generated Output
*.zip
audit/
audit-handover/
release-output/
StockFlow_Release_Checksums_*.txt
StockFlow_PostPackage_Evidence_Checksum_*.txt
